# Copie este arquivo para ".env" e preencha com os valores do SEU projeto.
# O arquivo .env nunca deve ser versionado (já está no .gitignore).

# Porta em que a API sobe (opcional, padrão 3000)
PORT=3000

# String de conexão do Postgres (Supabase > Project Settings > Database >
# Connection string, modo "Session pooler")
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# URL do projeto e chave "service_role" (Supabase > Project Settings > API).
# A service_role ignora as regras de RLS: use somente no backend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role

# Bucket do Supabase Storage onde ficam certificados, relatórios, fotos e
# comprovações (opcional, padrão "arquivos-sra")
SUPABASE_BUCKET=arquivos-sra

# Segredo usado para assinar os tokens JWT. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Senha provisória das contas de aluno criadas pela coordenação. O aluno é
# obrigado a trocá-la no primeiro login.
SENHA_PADRAO_PRIMEIRO_ACESSO=defina-uma-senha-provisoria

# Origem liberada no CORS (opcional, padrão http://localhost:5173)
FRONTEND_URL=http://localhost:5173
